[user]
	name = iyad-f
	email = 128908811+iyad-f@users.noreply.github.com

[init]
	defaultBranch = main

[core]
  editor = nvim

[fetch]
  prune = true

[push]
  autoSetupRemote = true

[diff]
  algorithm = histogram

[log]
  date = iso

[includeIf "hasconfig:remote.*.url:*gitlab.com/**"]
  path = ~/.config/git/config.gitlab

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

