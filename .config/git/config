[user]
	name = iyad-f
	email = dev@iyadzargar.com

[init]
	defaultBranch = main

[fetch]
  prune = true

[push]
  autoSetupRemote = true

[diff]
  algorithm = histogram

[log]
  date = iso

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

